# HubSpot OAuth app
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=http://localhost:3000/auth/hubspot/callback

# Anthropic (AI greetings)
ANTHROPIC_API_KEY=

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/engager

# Email (Resend)
RESEND_API_KEY=
DIGEST_FROM_EMAIL=digest@getrapport.app
ALERT_EMAIL=

# API authentication
ADMIN_SECRET=                        # platform operator secret — used to create new tenants
# Note: tenant API keys are stored in the DB (tenants.api_key), not env vars

# Server
BASE_URL=http://localhost:3000
PORT=3000
NODE_ENV=development
